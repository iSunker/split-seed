# =====================================================================
# 复制本文件为 .env 后按需修改。.env 含密钥，切勿提交/外传。
# =====================================================================

# 群晖统一：PUID=1026 PGID=100（与主/其他 QB、媒体属主一致）
PUID=1026
PGID=100
TZ=Asia/Shanghai

# reseed QB(:3060) 所在 NAS 的局域网 IP —— cross-seed / 编排器用它连 :3060
NAS_IP=192.168.1.10

# ---- qBittorrent(:3060) 鉴权 ----
# ★★ 2026-10-04 起**推荐 apikey 模式**：不改 qB 的 conf、不动白名单，
#   用 qB 自己的 API Key（WebUI → 选项 → WebUI → API Key）以
#   `Authorization: Bearer <key>` 只读访问 /api/v2/*。
#   ★ 起因：qB 升级到 v5.2.4 后 `AuthSubnetWhitelist` 为空 ⇒ 从 Docker 网络
#     `172.x` 进来的 cross-seed 拿不到授权 ⇒ 403 ⇒ cross-seed 起身即循环。
#   ★★ 但注意：**cross-seed 本身不支持 APIKey**（它只发 login 表单）——
#     apikey 模式服务的是**本项目自己的只读脚本**（诊断/巡检/台账），
#     以及任何用 Bearer 直读 qB 的工具。
#   三选一：apikey / subnet_whitelist(需改 qB conf) / password(需明文密码)。
QBIT_AUTH_MODE=apikey
# 模式=apikey 时填；模式=subnet_whitelist 时可留空；模式=password 时用下面的明文密码。
# ★ 生成：qB WebUI → 选项 → WebUI → 「API Key」→ 复制。切勿提交本文件。
QB_API_KEY=
QBIT_PASSWORD=
QBIT_CATEGORY=reseed-singles

# ★★ cross-seed 专用 qB 连接串（账号密码内嵌 URL）——2026-10-04：
#   cross-seed **只发 login 表单、不认 APIKey**，而 qB 升级后白名单为空 ⇒ 从 Docker
#   网 172.x 进来吃 403。不改 qB conf 的唯一出路 = 把账号密码内嵌进 URL 让它自己登录。
#   格式 http://<user>:<pass>@qbittorrent-reseed:3060（**服务名**，勿改 NAS_IP，会回环 timeout）。
#   ★ 凭据：绝不提交本文件（.env 已 gitignore）。留空则回退 QBIT_URL（白名单模式）。
# QBIT_URL_CRED=http://admin:your-qb-password@qbittorrent-reseed:3060

# ---- 路径（★务必与 config.yml / cross-seed 一致，且与源同一物理卷）----
# 大包根目录（cross-seed 把其"子目录=各单片"当 searchee）；多个用英文逗号分隔。
# ⚠ 只写"子目录就是发布名"的那一层。若大包根下还有一层分类目录
#   （如 DC…/DC系列电影/01.蝙蝠侠…/Batman Begins…-CHD），必须写到发布名的那一层，
#   否则中文标签会被当成 searchee 名，搜不到还白烧查询额度。
#   详见 SUMMARY.md §10.2。
DATA_DIRS=/volume1/video/download/movies/DouBan_IMDB.TOP250.Movies.Mixed.Collection.20240501.FRDS,/volume1/video/download/TV/My.Brilliant.Friend.S01-S04.2018.2160p.NowPlayer.WEB-DL.H265.DD5.1-ADWeb
# cross-seed 建硬链接（做种数据）的目录
LINK_DIR=/volume1/video/download/reseed_singles

# ★ 只在**建了硬链接农场之后**才需要这一行（build-farm.sh 用；cross-seed 不看它）。
#   切换农场 = 把上面 DATA_DIRS 改成农场那一条，比如
#       DATA_DIRS=/volume1/video/download/reseed/reseed_farm
#   而**原先那份 49 条源目录清单要挪到这里来**，否则 build-farm.sh --verify
#   会拿农场跟农场自己比、**永远报「无漂移」**（见 SUMMARY §16.2.1）。
#   格式同 DATA_DIRS。它只被 build-farm.sh 读 —— compose 只透传 DATA_DIRS，
#   容器看不到它，所以**改这行不用重建容器**。
FARM_SOURCES=/volume1/video/download/movies/xxx,/volume1/video/download/TV/yyy

# ★★ 2026-10-05：需要**递归镜像**的源（逗号分隔，NAS 路径视角，格式同 FARM_SOURCES）。
#   用处：大包里的**嵌套单片**（如 DC/01.绿箭侠…/Arrow.S01-S08…/Arrow.S01.Bluray…）
#   只按 FARM_SOURCES 的**一层**进不了农场；把它的**父目录**列在这里，就按 FARM_DEPTH 深镜像。
#   · 留空 = 无深源 ⇒ 行为与旧脚本**逐字节一致**（代码先上、行为惰性）。
#   · FARM_SOURCES 里的源仍是一层；两键都在 build-farm.sh 读，cross-seed 不看。
#   · 同一源同时出现在两键 ⇒ 取更深值 + 告警。
FARM_DEEP_SOURCES=
# 递归深度（从深源的**直接子项**往下算，对应 cross-seed 的 maxDataDepth）。默认 2。
# ★ 必须与 reseed-state.py init --depth N / pack.max_depth **对齐**，否则农场有条目、
#   库解析不到（两处都是 2 就一致）。
FARM_DEPTH=2

# ---- cross-seed ----
# 随机长字符串；编排器调 cross-seed webhook、以及 cross-seed 自身 API 鉴权用
CROSSSEED_API_KEY=please-change-me-to-a-long-random-string
# Prowlarr 的 Torznab 源，多个用英文逗号分隔。
# 每个索引器的地址+apikey 在 Prowlarr → 该索引器 → "Torznab Feed / API" 处获取。
TORZNAB_URLS=http://prowlarr:9696/1/api?apikey=xxxxxxxxxxxxxxxx,http://prowlarr:9696/2/api?apikey=yyyyyyyyyyyyyyyy
# ★ 可选：Prowlarr 自己的 API key（**不是**上面 Torznab 地址里那个）。
#   用途：`reseed-state.py quota --with-prowlarr` 拿它问
#   /api/v1/indexerstats 做"额度互校"（§16.1.2 来源 B）。
#   ★ 实测 Torznab 的 apikey 对 /api/v1/* 一律返回 401（2026-09-12），
#     两者**不是**同一个 key —— 要从 Prowlarr 网页 UI 里取：
#     Prowlarr → Settings → General → API Key。
#   ★ 留空就自动跳过来源 B（只报"未配置"），**不影响**额度台账的其余部分。
#   ★ 这是凭据：别写进命令行（会留在 shell 历史与进程列表里），只放这里。
#     也正因如此它**没有**命令行开关，`quota` 只从 .env 读。
# PROWLARR_API_KEY=
# Prowlarr 的地址（供来源 B 用）。★必须是 **NAS 的宿主机 IP**，不是容器名 ——
# drive-loop 跑在 NAS 宿主机上，`prowlarr` 这个服务名它解析不了。
# PROWLARR_URL=http://192.168.0.7:9696


# 匹配宽松度 / 是否跳过注入后校验 / 链接类型
# ★ 2026-09-13：MATCH_MODE 与 LINK_TYPE 是**绑在一起**的（互锁写在
#   cross-seed/config.js 的 resolveMatchMode 里，不是靠注释约定）：
#     LINK_TYPE=hardlink | symlink → matchMode 被强制 strict（否则写穿源文件）
#     LINK_TYPE=reflink            → MATCH_MODE 才作数，可以 partial/flexible
#   机理与两处实证见 README「源文件被写穿」。reflink 需要文件系统支持 COW
#   （本机 /volume1 已确认为 BTRFS）。
#   ★ 不要写 reflinkOrCopy：reflink 失败时它**静默整份拷贝**，而本卷已 100% 满；
#     config.js 会把它降级回 reflink（不支持就直接报错，绝不拷贝）。
#   ★ 这两个键要与 hlink/config.yml 的 matcher.match_mode / link_type 保持一致 ——
#     后者是**另一条**建链接的路径（orchestrator/hardlink.py::prestage），
#     不一致就会一半硬链接、一半 reflink。
MATCH_MODE=partial
SKIP_RECHECK=false
LINK_TYPE=reflink
